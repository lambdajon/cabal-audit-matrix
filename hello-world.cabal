cabal-version: 3.4
name:          hello-world
version:       0.1.0.0
synopsis:      Minimal hello world with an HLS-style project layout
license:       Apache-2.0
build-type:    Simple
tested-with:   GHC ==9.6.7 || ==9.8.4 || ==9.10.3 || ==9.12.2 || ==9.14.1

common warnings
  ghc-options: -Wall

common defaults
  default-language: GHC2021
  build-depends:    base >=4.18 && <5

library
  import:          warnings, defaults
  hs-source-dirs:  src
  exposed-modules: Hello
  build-depends:
    , bytestring
    , containers
    , hello-core
    , text

executable hello-world
  import:         warnings, defaults
  hs-source-dirs: exe
  main-is:        Main.hs
  build-depends:  hello-world

test-suite hello-world-test
  import:         warnings, defaults
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:  hello-world
